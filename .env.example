# RideSafe Environment Variables Example

# --- Database ---
# RideSafe uses PostgreSQL in every environment.
DATABASE_URL="postgresql://ridesafe:ridesafe_dev_password@localhost:5432/ridesafe_db?schema=public"
APP_URL="http://localhost:3000"

# --- Authentication ---
# Generate a secret: openssl rand -base64 32
JWT_SECRET="replace-with-at-least-32-random-characters"

# --- Optional External Services ---

# Redis (for live location caching)
REDIS_URL="redis://localhost:6379"

# Katsana GPS Tracking Integration
# KATSANA_API_URL="https://api.katsana.com"
# KATSANA_CLIENT_ID=""
# KATSANA_CLIENT_SECRET=""

# Wialon GPS Tracking Integration
# WIALON_API_URL="https://hst-api.wialon.com/wialon/ajax.html"
# WIALON_TOKEN=""

# Bukku Billing Integration
# BUKKU_API_KEY=""
# BUKKU_API_URL=""
# BUKKU_ORGANIZATION="RideSafe"

# Billplz registration payments. Keep mock mode explicitly enabled locally only.
BILLPLZ_MOCK_ENABLED="true"
# BILLPLZ_API_KEY=""
# BILLPLZ_COLLECTION_ID=""
# BILLPLZ_X_SIGNATURE_KEY=""
BILLPLZ_SANDBOX="true"
REGISTRATION_FEE_AMOUNT="50"

# Destructive/demo scripts are blocked unless explicitly enabled locally:
# ALLOW_DESTRUCTIVE_SEED="true"
# ALLOW_TEST_USERS="true"
# TEST_USER_PASSWORD="choose-a-local-test-password"

# Browser Web Push: generate once using npm run push:keys.
# Set the PUBLIC key before the production build, including in Vercel/Docker.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:transport@your-school.example"
# Random 32+ character secret for the independent hardware tracking worker.
TRACKING_WORKER_SECRET=""
