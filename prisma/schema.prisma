// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  students        Student[]
  buses           Bus[]
  routes          Route[]
  academicEvents  AcademicEvent[]
  calendarImports AcademicCalendarImport[]
  transportIssues TransportIssue[]
  auditLogs       AuditLog[]
  messages        Message[]
}

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  password           String
  role               String
  phone              String?
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])
  lastLatitude       Float?
  lastLongitude      Float?
  lastLocationUpdate DateTime?
  currentSpeedKmH    Float?        @default(30.0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deviceId           String?
  locale             String?       @default("en")
  isActive           Boolean       @default(true)
  personnelType      String? // DRIVER or MAINTAINER (both use the DRIVER role)
  licenseNumber      String?
  licenseExpiry      DateTime?
  onboardingDate     DateTime?
  offboardingDate    DateTime?
  offboardingReason  String?
  employmentStatus   String?       @default("ACTIVE") // ACTIVE, INACTIVE, ONBOARDING, OFFBOARDING, OFFBOARDED

  maintainedBuses             Bus[]                     @relation("MaintainerBus")
  maintainedTrips             Trip[]                    @relation("MaintainerTrips")
  pushSubscriptions           PushSubscription[]
  parentStudents              Student[]                 @relation("ParentStudents")
  trips                       Trip[]                    @relation("DriverTrips")
  emergencies                 EmergencyAlert[]          @relation("DriverEmergencies")
  buses                       Bus[]                     @relation("DriverBus")
  notifications               Notification[]
  sentMessages                Message[]                 @relation("SentMessages")
  receivedMessages            Message[]                 @relation("ReceivedMessages")
  messageThreads              Message[]                 @relation("MessageThreadUser")
  hiddenTripHistory           TripHistoryDeletion[]
  hiddenMessages              MessageDeletion[]
  trackingSessions            TrackingSession[]
  payments                    Payment[]                 @relation("ParentPayments")
  rideRatings                 RideRating[]              @relation("ParentRatings")
  lostFoundReports            LostFoundItem[]           @relation("LostFoundReports")
  driverShifts                DriverShift[]             @relation("DriverShifts")
  assignmentHistory           DriverAssignmentHistory[] @relation("DriverAssignmentHistory")
  submittedIssues             TransportIssue[]          @relation("IssueReporter")
  auditLogs                   AuditLog[]                @relation("AuditActor")
  calendarImports             AcademicCalendarImport[]  @relation("CalendarImporter")
  attendanceRequests          AttendanceRequest[]       @relation("AttendanceRequestParent")
  confirmedAttendanceRequests AttendanceRequest[]       @relation("AttendanceRequestConfirmer")
}

model Student {
  id                 String        @id @default(cuid())
  name               String
  grade              String
  level              String
  dob                DateTime?
  preferredStartDate DateTime?
  age                Int?
  photoUrl           String?
  parentContact1     String
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])
  parentContact2     String?
  isSelfPickup       Boolean       @default(false)
  selfPickupSession  String? // MORNING | PM | AFTER_SCHOOL
  pickupTime         String?
  status             String        @default("PENDING")
  studentCode        String?
  className          String?
  section            String?
  pickupAddress      String?
  dropoffAddress     String?
  isActive           Boolean       @default(true)

  parentId           String?
  parent             User?               @relation("ParentStudents", fields: [parentId], references: [id])
  routeId            String?
  route              Route?              @relation(fields: [routeId], references: [id])
  busId              String?
  bus                Bus?                @relation(fields: [busId], references: [id])
  pickupStopId       String?
  pickupStop         Stop?               @relation("PickupStop", fields: [pickupStopId], references: [id])
  dropoffStopId      String?
  dropoffStop        Stop?               @relation("DropoffStop", fields: [dropoffStopId], references: [id])
  attendances        Attendance[]
  attendanceRequests AttendanceRequest[]
  transportIssues    TransportIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, studentCode])
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Attendance {
  recordedById String?
  dedupeKey    String?  @unique
  id           String   @id @default(cuid())
  tripId       String
  studentId    String
  stopId       String?
  action       String
  latitude     Float?
  longitude    Float?
  gpsOverride  Boolean  @default(false)
  gpsDistanceM Int?
  timestamp    DateTime @default(now())

  trip    Trip    @relation(fields: [tripId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  stop    Stop?   @relation(fields: [stopId], references: [id])
}

// Uploaded historical rows without a recorded trip are kept separate from
// crew-confirmed attendance; source names remain snapshots, not assignments.
model AttendanceImportRecord {
  id             String   @id @default(cuid())
  organizationId String
  sourceKey      String
  date           DateTime
  session        String
  status         String
  studentName    String
  studentCode    String?
  matchedStudentId String?
  routeName      String?
  busLabel       String?
  time           String?
  sourceFile     String
  importedById   String
  createdAt      DateTime @default(now())

  @@unique([organizationId, sourceKey])
  @@index([organizationId, date])
}

model AttendanceRequest {
  id            String    @id @default(cuid())
  tripId        String
  studentId     String
  parentId      String
  action        String    @default("PICKED_UP")
  status        String    @default("PENDING")
  requestedAt   DateTime  @default(now())
  confirmedAt   DateTime?
  confirmedById String?

  trip        Trip    @relation(fields: [tripId], references: [id])
  student     Student @relation(fields: [studentId], references: [id])
  parent      User    @relation("AttendanceRequestParent", fields: [parentId], references: [id])
  confirmedBy User?   @relation("AttendanceRequestConfirmer", fields: [confirmedById], references: [id])

  @@unique([tripId, studentId, action])
  @@index([parentId, status])
  @@index([tripId, status])
}

model EmergencyAlert {
  id        String   @id @default(cuid())
  driverId  String
  latitude  Float?
  longitude Float?
  resolved  Boolean  @default(false)
  source    String   @default("DRIVER") // DRIVER or PARENT
  timestamp DateTime @default(now())

  driver User @relation("DriverEmergencies", fields: [driverId], references: [id])
}

model Bus {
  id                 String        @id @default(cuid())
  plateNumber        String        @unique
  busNumber          String?
  registrationNumber String?
  capacity           Int
  status             String        @default("ACTIVE")
  gpsStatus          String        @default("NOT_CONFIGURED")
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])

  maintainerId String?
  maintainer   User?   @relation("MaintainerBus", fields: [maintainerId], references: [id])
  driverId     String?
  driver       User?   @relation("DriverBus", fields: [driverId], references: [id])

  routeId String?
  route   Route?  @relation("RouteBuses", fields: [routeId], references: [id])

  qrToken          String?
  wialonUnitId     String? // Wialon hardware tracker unit ID
  katsanaVehicleId String? // Katsana fleet tracker vehicle ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingSessions  TrackingSession[]
  maintenanceLogs   MaintenanceLog[]
  trips             Trip[]
  students          Student[]
  assignmentHistory DriverAssignmentHistory[]
}

model Route {
  id             String        @id @default(cuid())
  name           String
  morningTime    String?
  afternoonTime  String?
  isActive       Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  buses             Bus[]                     @relation("RouteBuses")
  students          Student[]
  stops             Stop[]
  trips             Trip[]
  assignmentHistory DriverAssignmentHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
}

model Stop {
  id        String @id @default(cuid())
  routeId   String
  name      String
  latitude  Float
  longitude Float
  order     Int

  route           Route        @relation(fields: [routeId], references: [id])
  pickupStudents  Student[]    @relation("PickupStop")
  dropoffStudents Student[]    @relation("DropoffStop")
  attendances     Attendance[]
}

model Trip {
  maintainerId     String?
  maintainer       User?    @relation("MaintainerTrips", fields: [maintainerId], references: [id])
  id               String   @id @default(cuid())
  routeId          String
  driverId         String
  busId            String?
  status           String   @default("TRIP_CREATED")
  date             DateTime @default(now())
  delayMinutes     Int      @default(0)
  delayReason      String?
  serviceType      String   @default("MORNING") // MORNING | PM | AFTER_SCHOOL
  currentStopOrder Int      @default(0)

  route              Route               @relation(fields: [routeId], references: [id])
  driver             User                @relation("DriverTrips", fields: [driverId], references: [id])
  bus                Bus?                @relation(fields: [busId], references: [id])
  attendances        Attendance[]
  attendanceRequests AttendanceRequest[]
  ratings            RideRating[]
  historyDeletions   TripHistoryDeletion[]
}

model TripHistoryDeletion {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId, createdAt])
}

model Notification {
  metadata  String?
  dedupeKey String?  @unique
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Announcement {
  deletedAt      DateTime?
  id             String    @id @default(cuid())
  title          String
  body           String
  targetRole     String    @default("ALL")
  type           String    @default("INFO")
  sentCount      Int       @default(0)
  createdBy      String?
  organizationId String?
  tripId         String?
  busId          String?
  routeId        String?
  createdAt      DateTime  @default(now())
}

model Message {
  senderDeletedAt    DateTime?
  recipientDeletedAt DateTime?
  id                 String    @id @default(cuid())
  senderId           String
  recipientId        String
  content            String
  read               Boolean   @default(false)
  createdAt          DateTime  @default(now())
  organizationId     String?
  threadUserId       String?

  sender       User          @relation("SentMessages", fields: [senderId], references: [id])
  recipient    User          @relation("ReceivedMessages", fields: [recipientId], references: [id])
  threadUser   User?         @relation("MessageThreadUser", fields: [threadUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  deletions    MessageDeletion[]

  @@index([organizationId, threadUserId, createdAt])
}

model MessageDeletion {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model TrackingSession {
  id           String    @id @default(cuid())
  driverId     String
  busId        String
  deviceId     String
  startTime    DateTime  @default(now())
  endTime      DateTime?
  status       String    @default("ACTIVE")
  trackingMode String    @default("HYBRID")

  driver User @relation(fields: [driverId], references: [id])
  bus    Bus  @relation(fields: [busId], references: [id])
}

model Payment {
  id             String    @id @default(cuid())
  parentId       String
  bukkuInvoiceId String?
  checkoutUrl    String?
  amount         Float
  status         String    @default("PENDING")
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent User @relation("ParentPayments", fields: [parentId], references: [id])
}

model RideRating {
  id        String   @id @default(cuid())
  tripId    String
  parentId  String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  trip   Trip @relation(fields: [tripId], references: [id])
  parent User @relation("ParentRatings", fields: [parentId], references: [id])
}

model LostFoundItem {
  id          String   @id @default(cuid())
  reportedBy  String
  description String
  photoUrl    String?
  status      String   @default("OPEN") // OPEN, FOUND, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User @relation("LostFoundReports", fields: [reportedBy], references: [id])
}

model DriverShift {
  id          String    @id @default(cuid())
  driverId    String
  date        DateTime
  startTime   String
  endTime     String
  status      String    @default("SCHEDULED") // SCHEDULED, ACTIVE, COMPLETED, CANCELLED
  lateReason  String?
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  driver User @relation("DriverShifts", fields: [driverId], references: [id])
}

model MaintenanceLog {
  id            String    @id @default(cuid())
  busId         String
  type          String // OIL_CHANGE, TIRE, BRAKE, INSPECTION, OTHER
  description   String?
  scheduledDate DateTime
  completedDate DateTime?
  status        String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, OVERDUE
  cost          Float?
  createdAt     DateTime  @default(now())

  bus Bus @relation(fields: [busId], references: [id])
}

model PendingRegistration {
  id                 String    @id @default(cuid())
  parentName         String
  parentEmail        String
  parentContact1     String
  parentContact2     String?
  studentName        String
  studentGrade       String
  studentLevel       String    @default("Primary")
  dob                DateTime?
  preferredStartDate DateTime?
  selfPickupSession  String?
  amount             Float
  billId             String?   @unique
  billUrl            String?
  status             String    @default("PENDING") // PENDING, PAID, FAILED
  tempPassword       String?
  createdUserId      String?
  createdStudentId   String?
  organizationId     String?
  createdAt          DateTime  @default(now())
  paidAt             DateTime?
}

model AcademicEvent {
  id             String        @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  type           String        @default("EVENT") // HOLIDAY, EXAM, EVENT, TERM_START, TERM_END, ASSEMBLY
  isPublic       Boolean       @default(true)
  color          String?       @default("#1E3A8A")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model AcademicCalendarImport {
  id             String        @id @default(cuid())
  fileName       String
  academicYear   String
  eventCount     Int           @default(0)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  importedById   String
  importedBy     User          @relation("CalendarImporter", fields: [importedById], references: [id])
  createdAt      DateTime      @default(now())
}

model DriverAssignmentHistory {
  id          String   @id @default(cuid())
  driverId    String
  driver      User     @relation("DriverAssignmentHistory", fields: [driverId], references: [id])
  busId       String?
  bus         Bus?     @relation(fields: [busId], references: [id])
  routeId     String?
  route       Route?   @relation(fields: [routeId], references: [id])
  action      String // ONBOARDED, ASSIGNED, REASSIGNED, OFFBOARDED
  reason      String?
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([driverId, effectiveAt])
}

model TransportIssue {
  id             String        @id @default(cuid())
  reporterId     String
  reporter       User          @relation("IssueReporter", fields: [reporterId], references: [id])
  studentId      String?
  student        Student?      @relation(fields: [studentId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  category       String
  subject        String
  description    String
  priority       String        @default("NORMAL")
  status         String        @default("OPEN")
  resolution     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([reporterId, createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         String
  entityType     String
  entityId       String?
  details        String?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
