# RideSafe — Production Environment
# =====================================
# Copy this file to .env.production and fill in real values before deploying.
# NEVER commit real credentials to version control.

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
POSTGRES_USER="ridesafe"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASS"
POSTGRES_DB="ridesafe_db"
DATABASE_URL="postgresql://ridesafe:CHANGE_ME_STRONG_PASS@postgres:5432/ridesafe_db?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
# For cPanel: Use Upstash Redis (free tier) — https://upstash.com
# Format: redis://default:TOKEN@HOST:PORT
REDIS_URL="redis://redis:6379"

# For Upstash (production recommended):
# UPSTASH_REDIS_REST_URL="https://YOUR-UPSTASH-ENDPOINT.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# ── Authentication ────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_STRING_USE_OPENSSL_RAND_HEX_32"
APP_URL="https://YOUR_DOMAIN.COM"

# ── Communication Services ────────────────────────────────────────────────────
# Resend (Email) — https://resend.com
RESEND_API_KEY="re_XXXXXXXXXXXX"
EMAIL_FROM="noreply@yourdomain.com"

# WhatsApp Business API (optional)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# ── GPS / Wialon ──────────────────────────────────────────────────────────────
WIALON_API_URL="https://hst-api.wialon.com/wialon/ajax.html"
WIALON_TOKEN="YOUR_WIALON_TOKEN"

# ── Fleet / billing integrations ─────────────────────────────────────────────
KATSANA_CLIENT_ID=""
KATSANA_CLIENT_SECRET=""
KATSANA_API_URL="https://api.katsana.com"
BUKKU_API_KEY=""
BUKKU_API_URL=""
BUKKU_ORGANIZATION="RideSafe"
BILLPLZ_API_KEY=""
BILLPLZ_COLLECTION_ID=""
BILLPLZ_X_SIGNATURE_KEY=""
BILLPLZ_SANDBOX="true"
BILLPLZ_MOCK_ENABLED="false"
# Local Docker only: set both values true with APP_URL=http://localhost:3500.
# Mock payments remain blocked for non-loopback APP_URL values.
ALLOW_LOCAL_PAYMENT_MOCK="false"
REGISTRATION_FEE_AMOUNT="50"

# ── App Config ────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3000"

# Browser Web Push: generate once using npm run push:keys.
# Set the PUBLIC key before the production build, including in Vercel/Docker.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:transport@your-school.example"
# Random 32+ character secret for the independent hardware tracking worker.
TRACKING_WORKER_SECRET=""
