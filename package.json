{
  "name": "school-bus-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "deploy": "docker compose --env-file .env.production up --build -d",
    "admin:create": "node scripts/bootstrap-admin.mjs",
    "tracking:worker": "node --env-file=.env scripts/tracking-worker.mjs",
    "push:keys": "node scripts/generate-push-keys.mjs",
    "transport:check": "node --env-file=.env scripts/check-transport.mjs",
    "prebuild": "node scripts/verify-source.mjs",
    "source:check": "node scripts/verify-source.mjs",
    "setup:docker": "node scripts/setup-docker.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.18.2",
    "ioredis": "^5.10.1",
    "jose": "^6.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "next": "^16.3.4",
    "prisma": "5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
